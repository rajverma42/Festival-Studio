{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile holding preferences, display name and sync settings",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique user identifier matching request.auth.uid"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 100
        },
        "theme": {
          "type": "string",
          "description": "Preferred interface theme",
          "enum": ["light", "dark", "system"]
        },
        "language": {
          "type": "string",
          "description": "Preferred interface language",
          "enum": ["en", "hi"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when profile was last updated"
        }
      },
      "required": ["userId", "updatedAt"]
    },
    "UserDraft": {
      "title": "UserDraft",
      "description": "Festival poster draft or template customization saved by user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Draft ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Author UID"
        },
        "title": {
          "type": "string",
          "description": "Draft title or festival name",
          "maxLength": 150
        },
        "data": {
          "type": "string",
          "description": "Serialized canvas state / JSON layers representation",
          "maxLength": 500000
        },
        "format": {
          "type": "string",
          "description": "Canvas format e.g. post, status, gif",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "userId", "data", "createdAt", "updatedAt"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Publicly shared festival greetings and templates created by users",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Post ID",
          "maxLength": 128
        },
        "authorId": {
          "type": "string",
          "description": "Author user ID"
        },
        "authorName": {
          "type": "string",
          "description": "Author display name",
          "maxLength": 100
        },
        "festival": {
          "type": "string",
          "description": "Festival tag or occasion",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "description": "Post title or wish",
          "maxLength": 200
        },
        "likesCount": {
          "type": "number",
          "description": "Number of appreciations"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "authorId", "festival", "title", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user preferences and profile data"
    },
    "/users/{userId}/drafts/{draftId}": {
      "schema": "UserDraft",
      "description": "User saved poster designs and drafts"
    },
    "/community_posts/{postId}": {
      "schema": "CommunityPost",
      "description": "Community shared greeting posters and wishes"
    }
  }
}
