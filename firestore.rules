rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access unless explicitly granted
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('theme' in data) || data.theme in ['light', 'dark', 'system']) &&
        (!('language' in data) || data.language in ['en', 'hi']) &&
        data.updatedAt is timestamp;
    }

    // User Draft Validation
    function isValidUserDraft(data, userId) {
      return data.userId == userId &&
        data.id is string && data.id.size() <= 128 &&
        data.data is string && data.data.size() <= 500000 &&
        (!('title' in data) || (data.title is string && data.title.size() <= 150)) &&
        (!('format' in data) || (data.format is string && data.format.size() <= 32)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Community Post Validation
    function isValidCommunityPost(data) {
      return data.authorId == request.auth.uid &&
        data.id is string && data.id.size() <= 128 &&
        data.festival is string && data.festival.size() <= 100 &&
        data.title is string && data.title.size() <= 200 &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
        (!('likesCount' in data) || data.likesCount is number) &&
        data.createdAt is timestamp;
    }

    // User Profile rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // User Drafts Subcollection
      match /drafts/{draftId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(draftId) && isValidUserDraft(incoming(), userId);
        allow update: if isOwner(userId) && isValidUserDraft(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }
    }

    // Community Posts rules
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(postId) && isValidCommunityPost(incoming());
      allow update: if isSignedIn() && existing().authorId == request.auth.uid &&
        isValidCommunityPost(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
    }
  }
}
